# 백엔드(또는 mock 서버) 주소. /api/* 요청이 이 주소로 전달됩니다.
# mock 서버: http://localhost:4000 · Spring Boot(../backend): http://localhost:8080
API_BASE_URL=http://localhost:4000

# 네이버 지도 Client ID (NCP Maps 콘솔 > Application의 ncpKeyId).
# Web 서비스 URL에 로컬/배포 도메인(예: http://localhost:3000)을 등록하고 Dynamic Map을 켜야 합니다.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# Map Style Editor에서 Publish한 My Style ID (선택).
# 값이 있으면 GL 벡터맵 + 커스텀 스타일을 켭니다. 브라우저 그래픽 가속이 필요합니다.
# NEXT_PUBLIC_NAVER_MAP_STYLE_ID=

# Style ID 없이 GL 벡터맵만 켜려면 true (선택).
# NEXT_PUBLIC_NAVER_MAP_GL=false

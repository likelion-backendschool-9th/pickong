# 로컬 개발용 비밀값. 이 파일을 복사해 backend/.env로 만들고 값을 채웁니다. (.env는 git에 올라가지 않습니다)
#   cp .env.example .env
# 운영에서는 파일 대신 환경변수로 넣습니다.

# Access Token(JWT) 서명 비밀값. 32바이트 이상 랜덤 값: openssl rand -base64 32
JWT_SECRET=

# 인증 쿠키를 HTTPS에서만 보낼지. 로컬(http://localhost)은 false, 운영은 넣지 않거나 true
COOKIE_SECURE=false

# 인증 쿠키 Domain. 로컬 · 지금 운영 구조에서는 비워 둡니다.
COOKIE_DOMAIN=

# 프론트 기준 주소. 소셜 로그인 콜백(Redirect URI)과 로그인 후 이동할 화면이 이 주소를 씁니다.
# 로컬: http://localhost:3000 / 운영: https://프론트도메인
FRONTEND_BASE_URL=http://localhost:3000

# 채팅 실시간 전달의 서버 간 중계(Redis). 주석 그대로 두면 Redis 없이 서버 안에서만 전달합니다(로컬 · 서버 1대).
# 써 보려면 저장소 루트에서 docker compose --profile redis up -d redis 후, bootRun이면 localhost · Docker 백엔드면 redis
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# 소셜 로그인 키. 받은 제공자만 주석(#)을 풀고 값을 넣습니다.
# 값이 빈 줄(KAKAO_CLIENT_ID=)을 남기면 application.yml의 기본값 대신 빈 값이 들어가 앱이 시작하지 않습니다.

# 카카오 로그인 (developers.kakao.com > 내 애플리케이션 > 앱 키: REST API 키 · 보안: Client Secret)
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=

# Google 로그인 (console.cloud.google.com > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

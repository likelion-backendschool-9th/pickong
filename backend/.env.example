# 로컬 개발용 비밀값. 이 파일을 복사해 backend/.env로 만들고 값을 채웁니다. (.env는 git에 올라가지 않습니다)
#   cp .env.example .env
# 운영에서는 파일 대신 환경변수로 넣습니다.

# Access Token(JWT) 서명 비밀값. 32바이트 이상 랜덤 값: openssl rand -base64 32
JWT_SECRET=

# 인증 쿠키를 HTTPS에서만 보낼지. 로컬(http://localhost)은 false, 운영은 넣지 않거나 true
COOKIE_SECURE=false

# 인증 쿠키 Domain. 로컬 · 지금 운영 구조에서는 비워 둡니다.
COOKIE_DOMAIN=

# 프론트 기준 주소. 소셜 로그인 콜백(Redirect URI)과 로그인 후 이동할 화면이 이 주소를 씁니다.
# 로컬: http://localhost:3000 / 운영: https://프론트도메인
FRONTEND_BASE_URL=http://localhost:3000

# 소셜 로그인 키. 받은 제공자만 주석(#)을 풀고 값을 넣습니다.
# 값이 빈 줄(KAKAO_CLIENT_ID=)을 남기면 application.yml의 기본값 대신 빈 값이 들어가 앱이 시작하지 않습니다.

# 카카오 로그인 (developers.kakao.com > 내 애플리케이션 > 앱 키: REST API 키 · 보안: Client Secret)
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=

# Google 로그인 (console.cloud.google.com > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Cloudflare R2 사진 업로드 (Cloudflare 대시보드 > R2). 없으면 앱은 뜨고 사진 업로드만 실패합니다.
# 계정 ID: 대시보드 R2 화면의 Account ID 32자만 넣습니다. (https://... 주소 전체가 아님)
# API 토큰: R2 > Manage API Tokens에서 이 버킷만 Object Read & Write 권한으로 발급
# 공개 주소: 버킷 Settings > Public access의 r2.dev 주소(개발용) 또는 연결한 도메인(운영), 끝에 / 없이
# 브라우저가 R2에 직접 올리므로 버킷 CORS에 프론트 주소(http://localhost:3000), PUT, Content-Type과 If-None-Match 헤더를 허용해야 합니다.
# 로컬과 운영은 토큰과 버킷을 따로 쓰는 것을 권장합니다.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=
